---
import Sheet from "../layouts/Sheet.astro";
import Panel from "../components/Panel.astro";
import Strip from "../components/Strip.astro";
import Spark from "../components/Spark.astro";
import Statement from "../components/Statement.astro";
import { companies, header } from "../lib/read.mjs";
import * as f from "../lib/fmt.mjs";

const view = companies.map((company) => {
  const metrics = company.results.model?.metrics ?? [];
  const errors = metrics.map((m) => m.reproduction_error).filter((n) => typeof n === "number");
  const worst = errors.length ? errors.reduce((a, b) => (Math.abs(a) > Math.abs(b) ? a : b)) : null;
  const statement = company.statement;
  const earliest = statement?.columns?.[0]?.period_end ?? null;
  return {
    company,
    h: header(company),
    metrics,
    worst,
    statement,
    earliest,
    observations: metrics.reduce((n, m) => n + (m.observations ?? []).length, 0),
    setAside: metrics.reduce((n, m) => n + (m.notes ?? []).length, 0),
    lines: statement?.rows?.length ?? 0,
    periods: statement?.columns?.length ?? 0,
    filings: statement?.sources?.length ?? 0,
  };
});
---

<Sheet title="Model" subsystem="Statement" index="04">
  {view.map((v) => (
    <div data-company={v.company.ticker} hidden>

      <section class="sheet-section">
        <h2 class="section-heading">Before the projection</h2>
        <div class="grid2" style="margin-top:16px">
          {v.metrics.map((metric) => (
            <Panel
              n="RC"
              name={`${metric.metric} · reproduction`}
              figure={f.signedPctPoints(metric.reproduction_error)}
              unit="widest error"
            >
              <p>
                {(metric.reproduction ?? []).length} reported periods rebuilt from history alone, then
                compared with what the company printed.
              </p>
            </Panel>
          ))}
        </div>
      </section>

      <section class="sheet-section">
        <h2 class="section-heading">Income statement</h2>
        <div style="margin-top:16px">
          <Statement company={v.company} />
        </div>
      </section>

      <section class="sheet-section">
        <h2 class="section-heading">The lines we estimate</h2>
        <div class="panel scroll-x" style="margin-top:16px">
          <div class="panel-body">
            <table class="ledger">
              <thead>
                <tr>
                  <th>Line</th>
                  <th class="n">Last reported</th>
                  <th class="n">Growth rate</th>
                  <th class="n">Weight</th>
                  <th class="n">Sample</th>
                  <th class="n">Estimate</th>
                  <th class="n">Trail</th>
                </tr>
              </thead>
              <tbody>
                {v.metrics.map((metric) => {
                  const forecast = (v.company.results.forecast?.metrics ?? []).find(
                    (x) => x.metric_label === metric.metric,
                  );
                  const series = (metric.observations ?? [])
                    .slice()
                    .sort((a, b) => String(a.period_end).localeCompare(String(b.period_end)))
                    .map((o) => o.value)
                    .filter((value) => typeof value === "number");
                  return (
                    <tr>
                      <td>{metric.metric}</td>
                      <td class="n">{f.metricValue(metric.level?.raw, metric.units)}</td>
                      <td class="n">{f.pct((metric.growth?.shrunk ?? 0) * 100)}</td>
                      <td class="n">{f.ratio(metric.growth?.shrinkage_weight)}</td>
                      <td class="n">{f.count(metric.growth?.observations)}</td>
                      <td class="n t-white">
                        {forecast ? f.metricValue(forecast.forecast, forecast.units) : "—"}
                      </td>
                      <td class="n">
                        <Spark values={series} projected={forecast?.forecast ?? null} />
                      </td>
                    </tr>
                  );
                })}
              </tbody>
            </table>
            <p class="meta" style="margin:12px 0 0">
              Weight is how far the trailing rate is trusted against the prior.
            </p>
          </div>
        </div>

        <div class="grid2" style="margin-top:16px">
          {v.metrics
            .filter((metric) => (metric.notes ?? []).length > 0)
            .map((metric) => (
              <div class="rule amber">
                <span class="t">{metric.metric} · set aside</span>
                {(metric.notes ?? [])[0]}
              </div>
            ))}
        </div>
      </section>

      <section class="sheet-section">
        <Strip
          items={[
            { label: "Statement lines", value: String(v.lines), context: "As printed in the releases." },
            { label: "Periods", value: String(v.periods), context: "Every period the filings report." },
            { label: "Widest error", value: f.signedPctPoints(v.worst), context: "Against a period already reported." },
            { label: "Set aside", value: String(v.setAside), context: "Values that could not be put on one scale." },
            { label: "Filings read", value: String(v.filings), context: "Each cell names the one it came from." },
          ]}
        />
      </section>
    </div>
  ))}
</Sheet>
