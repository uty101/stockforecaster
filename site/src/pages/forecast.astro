---
import Sheet from "../layouts/Sheet.astro";
import Panel from "../components/Panel.astro";
import StatusCard from "../components/StatusCard.astro";
import Strip from "../components/Strip.astro";
import Distribution from "../components/Distribution.astro";
import { companies, header, sum } from "../lib/read.mjs";
import * as f from "../lib/fmt.mjs";

const all = companies.flatMap((c) =>
  (c.results.forecast?.metrics ?? []).map((m) => ({ company: c, metric: m })),
);
const withStreet = all.filter((r) => typeof r.metric.consensus === "number");
const totalUsd = sum(companies, (c) => c.results.cost?.spent_usd ?? 0);

// The one dense line describing how the figure was set.
function setBy(metric) {
  const parts = [`preset ${metric.preset}`];
  for (const c of metric.conditions ?? []) {
    const input = c.input === null ? "not fired" : String(c.input);
    parts.push(`${c.name} ${input}${typeof c.multiplier === "number" ? ` x${c.multiplier}` : ""}`);
  }
  parts.push(metric.lambda === 1 ? "no damping" : `damping ${f.position(metric.lambda)}`);
  return parts.join("  ·  ");
}
---

<Sheet title="Forecast" subsystem="Estimates" index="02">
  <div class="lede-row">
    <div class="lede">
      <span class="bar"></span>
      <p>
        Twelve estimates, each with the Street figure it will be scored against and the range it
        sits inside. Where no Street figure is published, the page says so.
      </p>
    </div>
    <StatusCard
      name="The book"
      word={`${all.length}`}
      summary="Estimates submitted this run"
      tone="teal"
      fill={1}
      rows={[
        ["Names", String(companies.length)],
        ["With a Street figure", `${withStreet.length}/${all.length}`],
        ["Spend", f.usd(totalUsd)],
      ]}
    />
  </div>

  {companies.map((company) => {
    const h = header(company);
    const metrics = company.results.forecast?.metrics ?? [];
    return (
      <section class="sheet-section">
        <h2 class="section-heading">{h.company} · {h.period}</h2>

        {metrics.map((metric) => {
          const street = typeof metric.consensus === "number" ? metric.consensus : null;
          const gap = street === null ? null : f.gapLabel(metric.own_estimate, street, metric.units);
          return (
            <div style="margin-top:16px">
              <div class="grid2">
                <Panel
                  n="01"
                  name="Our estimate"
                  figure={f.metricValue(metric.forecast, metric.units)}
                  unit={f.unitLabel(metric.units)}
                >
                  <p>{metric.metric_label} for {h.period}, on the basis the company reports.</p>
                </Panel>
                <Panel
                  n="02"
                  name="The Street"
                  figure={street === null ? "—" : f.metricValue(street, metric.units)}
                  unit={street === null ? "no coverage" : f.unitLabel(metric.units)}
                >
                  <p>
                    {street === null
                      ? "No published consensus for this line, so the estimate stands on the filings alone."
                      : "Consensus as it stood at the lock date, taken once and carried unchanged."}
                  </p>
                </Panel>
              </div>

              <div class="panel" style="margin-top:16px">
                <div class="panel-head">
                  <span class="n">04</span>
                  <span class="eyebrow">{metric.metric_label} · the range</span>
                  <span class="plus">+</span>
                </div>
                <div class="panel-body">
                  <Distribution metric={metric} />
                  <p class="small t-secondary" style="margin:6px 0 0">
                    p10 to p90 for {metric.metric_label}, with the Street on the same axis.
                  </p>
                </div>
              </div>

              <div class="panel" style="margin-top:16px">
                <div class="panel-head">
                  <span class="n">05</span>
                  <span class="eyebrow">The gap in words</span>
                  <span class="plus">+</span>
                </div>
                <div class="panel-body">
                  <p class="prose" style="margin:0">
                    {street === null ? (
                      <>
                        {metric.metric_label} of {f.metricValue(metric.forecast, metric.units)} with no
                        published Street figure to sit against, carried at full weight.
                      </>
                    ) : metric.forecast === street ? (
                      <>
                        {metric.metric_label} of {f.metricValue(metric.forecast, metric.units)} in line with
                        the Street, carried at {f.position(metric.lambda)} of full weight.
                      </>
                    ) : (
                      <>
                        {metric.metric_label} of {f.metricValue(metric.forecast, metric.units)} against the
                        Street at {f.metricValue(street, metric.units)}, a gap of {gap}, carried at{" "}
                        {f.position(metric.lambda)} of full weight.
                      </>
                    )}
                  </p>
                  <p class="meta" style="margin:12px 0 0">{setBy(metric)}</p>
                </div>
              </div>

              <details class="panel exp" style="margin-top:16px">
                <summary class="panel-head">
                  <span class="n">06</span>
                  <span class="eyebrow">What set the weight</span>
                  <span class="plus">+</span>
                </summary>
                <div class="panel-body">
                  <div class="grid2">
                    <div>
                      <table class="ledger">
                        <thead>
                          <tr><th>Condition</th><th>Measured</th><th class="n">Multiplier</th></tr>
                        </thead>
                        <tbody>
                          {(metric.conditions ?? []).map((c) => (
                            <tr>
                              <td>{c.name}</td>
                              <td>{c.input === null ? "not fired" : String(c.input)}</td>
                              <td class="n">{typeof c.multiplier === "number" ? f.ratio(c.multiplier) : "—"}</td>
                            </tr>
                          ))}
                        </tbody>
                      </table>
                    </div>
                    <div class="stack-16">
                      <div class="rule amber">
                        <span class="t">Calibration</span>
                        {metric.beta_measured
                          ? "The multiplier on each condition is fitted to realised outcomes."
                          : "Not yet calibrated against realised outcomes. The multipliers come from the stated preset."}
                      </div>
                      <div class="rule teal">
                        <span class="t">The comparison</span>
                        {street === null
                          ? "No consensus is published for this line, so nothing was taken."
                          : `Taken once at ${company.results.forecast?.consensus_bus?.tapped_at_node ?? "the source"} and carried unchanged to the position.`}
                      </div>
                    </div>
                  </div>
                  <p class="small t-secondary" style="margin:14px 0 0">{metric.rationale}</p>
                </div>
              </details>
            </div>
          );
        })}
      </section>
    );
  })}

  <section class="sheet-section">
    <Strip
      items={[
        { label: "Estimates", value: String(all.length), context: "Three lines for each of four names." },
        { label: "With coverage", value: `${withStreet.length}/${all.length}`, context: "A published Street figure exists." },
        { label: "Weight", value: f.position(1), context: "Every estimate carried unadjusted." },
        { label: "Spend", value: f.usd(totalUsd), context: "Measured, not asserted." },
      ]}
    />
  </section>
</Sheet>
