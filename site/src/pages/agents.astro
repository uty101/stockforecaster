---
import Sheet from "../layouts/Sheet.astro";
import Panel from "../components/Panel.astro";
import Strip from "../components/Strip.astro";
import { prompts, nodes, companies, costByAgent, primary } from "../lib/read.mjs";
import * as f from "../lib/fmt.mjs";

// The roster is read from the prompt directory, so a reader that exists without
// a card here cannot go unnoticed.
const spend = new Map();
for (const company of companies) {
  for (const row of costByAgent(company)) {
    const prior = spend.get(row.agent) ?? { usd: 0, calls: 0, model: row.model };
    spend.set(row.agent, { usd: prior.usd + row.usd, calls: prior.calls + row.calls, model: row.model });
  }
}

const registryAgents = new Set(nodes.filter((n) => n.agent).map((n) => n.agent));
const rosterNames = new Set(prompts.map((p) => p.name));
const orphans = [...registryAgents].filter((a) => !rosterNames.has(a));
const unplaced = prompts.filter((p) => !registryAgents.has(p.name));
const inSync = orphans.length === 0 && unplaced.length === 0;

const layers = [...new Set(prompts.map((p) => p.layer ?? "unplaced"))].sort();
const tiers = prompts.reduce((acc, p) => {
  acc[p.tier] = (acc[p.tier] ?? 0) + 1;
  return acc;
}, {});

const layerSpend = layers.map((layer) => {
  const rows = prompts.filter((p) => (p.layer ?? "unplaced") === layer);
  const usd = rows.reduce((n, p) => n + (spend.get(p.name)?.usd ?? 0), 0);
  return { layer, count: rows.length, usd };
});
const maxSpend = Math.max(0.0001, ...layerSpend.map((l) => l.usd));
---

<Sheet title="Agents" subsystem="Roster" index="07">

  <section class="sheet-section">
    <h2 class="section-heading">Layers, sized by spend</h2>
    <div class="panel" style="margin-top:16px">
      <div class="panel-body">
        <svg viewBox={`0 0 560 ${layerSpend.length * 30 + 16}`} width="100%" role="img"
          aria-label="Each layer sized by what it cost">
          {layerSpend.map((row, i) => {
            const y = i * 30 + 8;
            const width = (row.usd / maxSpend) * 300;
            return (
              <g>
                <text x="0" y={y + 15} class="tick">{row.layer}</text>
                <rect x="190" y={y} width={Math.max(1, width)} height="20" fill="none" stroke="#A77BFF" stroke-width="1" />
                <text x={196 + Math.max(1, width)} y={y + 15} class="tick">
                  {f.usd(row.usd, 3)} · {row.count}
                </text>
              </g>
            );
          })}
        </svg>
        <p class="small t-secondary" style="margin:6px 0 0">
          Layers run in the order shown. The nine workstreams in the analyse layer run together.
        </p>
      </div>
    </div>
  </section>

  {layers.map((layer) => (
    <section class="sheet-section">
      <h2 class="section-heading">{layer}</h2>
      <div class="panel scroll-x" style="margin-top:16px">
        <div class="panel-body">
          <table class="ledger">
            <thead>
              <tr>
                <th>Reader</th>
                <th>Tier</th>
                <th>Model</th>
                <th class="n">Version</th>
                <th class="n">Calls</th>
                <th class="n">Spend</th>
                <th>What it reads</th>
              </tr>
            </thead>
            <tbody>
              {prompts
                .filter((p) => (p.layer ?? "unplaced") === layer)
                .map((p) => {
                  const row = spend.get(p.name);
                  return (
                    <tr>
                      <td>{p.name}</td>
                      <td><span class={`state ${p.tier === "none" ? "abstained" : "agent"}`}>{p.tier}</span></td>
                      <td class="t-secondary">{row?.model ?? "no model"}</td>
                      <td class="n">{p.version ?? "—"}</td>
                      <td class="n">{row ? f.count(row.calls) : "—"}</td>
                      <td class="n">{row ? f.usd(row.usd, 3) : "—"}</td>
                      <td class="t-secondary">{p.summary ?? "—"}</td>
                    </tr>
                  );
                })}
            </tbody>
          </table>
        </div>
      </div>
    </section>
  ))}

  <section class="sheet-section">
    <div class="grid2">
      <Panel n="01" name="The reader without a model" figure={String(tiers.none ?? 0)} unit="on the roster">
        <p>
          One workstream extends the reported series and nothing else. It reaches a figure from the
          filings by arithmetic, so it still returns a view when nothing else can.
        </p>
      </Panel>
      <Panel n="02" name="One call on the deep tier" figure={String(tiers.deep ?? 0)} unit="deep tier">
        <p>
          The weighting is the only place where the whole book is read at once. Everything before it
          reads one document or one question, which the cheaper tiers do at the same accuracy.
        </p>
      </Panel>
    </div>
  </section>

  <section class="sheet-section">
    <Strip
      items={[
        { label: "Readers", value: String(prompts.length), context: "Taken from the written instructions." },
        { label: "Workstreams", value: String(nodes.filter((n) => n.stage === "E").length), context: "Running together on each name." },
        { label: "Deep calls", value: String(primary.results.cost?.deep_calls ?? 0), context: "One weighting for each name." },
        { label: "Roster", value: inSync ? "in sync" : "adrift", context: "Checked against the registry.", tone: inSync ? "teal" : "red" },
      ]}
    />
  </section>
</Sheet>

<style>
  .tick { font-size: 10px; fill: var(--faint); font-family: var(--mono); }
</style>
