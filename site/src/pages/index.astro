---
import Sheet from "../layouts/Sheet.astro";
import SignalFlow from "../components/SignalFlow.astro";
import Gates from "../components/Gates.astro";
import Tape from "../components/Tape.astro";
import StatusCard from "../components/StatusCard.astro";
import Strip from "../components/Strip.astro";
import { companies, header, nodes, callsOf } from "../lib/read.mjs";
import * as f from "../lib/fmt.mjs";

const view = companies.map((company) => {
  const h = header(company);
  const tape = company.tape ?? [];
  const calls = callsOf(company);
  return {
    company,
    h,
    claims: (company.results.evidence?.claims ?? []).length,
    checked: company.results.reconciliation?.citations_checked ?? 0,
    matched: company.results.reconciliation?.citations_matched ?? 0,
    documents: Object.keys(company.results.evidence?.documents ?? {}).length,
    usd: company.results.cost?.spent_usd ?? 0,
    events: tape.length,
    elapsed: tape.length > 1 ? tape[tape.length - 1].ts - tape[0].ts : 0,
    tokens: calls.reduce(
      (n, call) =>
        n + (call.input_tokens ?? 0) + (call.output_tokens ?? 0) + (call.cache_read_tokens ?? 0) + (call.cache_write_tokens ?? 0),
      0,
    ),
    complete: h.last_completed_stage === "I",
  };
});
---

<Sheet title="At the root" subsystem="Coverage" index="01">
  {view.map((v) => (
    <div data-company={v.company.ticker} hidden>
      <div class="lede-row">
        <div class="lede">
          <span class="bar"></span>
          <p>
            Three estimates for {v.h.company}, each tracing from a figure on this page back to the
            filing it was read from, through the workstreams that argued it and the checks that kept it.
          </p>
        </div>
        <StatusCard
          name="Coverage"
          word={v.complete ? "Complete" : "Partial"}
          summary={v.complete ? "Carried to the estimate" : `Stopped at ${v.h.last_completed_stage}`}
          tone={v.complete ? "teal" : "amber"}
          fill={v.complete ? 1 : 0.5}
          rows={[
            ["Period", v.h.period],
            ["Estimates", "3"],
            ["Claims read", f.count(v.claims)],
            ["Quotes matched", `${f.count(v.matched)}/${f.count(v.checked)}`],
            ["Spend", f.usd(v.usd)],
          ]}
        />
      </div>

      <section class="sheet-section">
        <h2 class="section-heading">From filing to estimate</h2>
        <p class="prose small t-secondary" style="margin:8px 0 0">
          Line weight and speed carry the number of checked claims each route moved on the
          {" "}{v.h.ticker} run. Select any box for what it read and what it did.
        </p>
        <SignalFlow company={v.company} />
        <Gates company={v.company} />
      </section>

      <section class="sheet-section">
        <h2 class="section-heading">The run</h2>
        <div class="grid2" style="margin-top:16px; grid-template-columns: minmax(0,1.4fr) minmax(0,1fr)">
          <Tape company={v.company} />
          <div class="panel">
            <div class="panel-head">
              <span class="n">SUM</span>
              <span class="eyebrow">{v.h.ticker} · {v.h.period}</span>
              <span class="plus">+</span>
            </div>
            <div class="panel-body">
              <div class="kv">
                <div class="row"><span class="k">Tokens</span><span class="v num">{f.tokens(v.tokens)}</span></div>
                <div class="row"><span class="k">Spend</span><span class="v num">{f.usd(v.usd)}</span></div>
                <div class="row"><span class="k">Elapsed</span><span class="v num">{f.seconds(v.elapsed)}</span></div>
                <div class="row"><span class="k">Claims</span><span class="v num">{f.count(v.claims)}</span></div>
                <div class="row"><span class="k">Documents</span><span class="v num">{f.count(v.documents)}</span></div>
                <div class="row"><span class="k">Events recorded</span><span class="v num">{f.count(v.events)}</span></div>
              </div>
            </div>
          </div>
        </div>
      </section>


      <section class="sheet-section">
        <h2 class="section-heading">What has been checked, and what has not</h2>
        <p class="prose small t-secondary" style="margin:8px 0 0">
          The two claims worth separating on any forecasting system: whether the evidence behind a
          number was verified, and whether the number itself has ever been scored.
        </p>
        <div class="grid2" style="margin-top:16px">
          <div class="panel">
            <div class="panel-head">
              <span class="eyebrow">Checked</span>
              <span class="plus">+</span>
            </div>
            <div class="panel-body">
              <div class="kv">
                <div class="row"><span class="k">Quotes matched to their filing</span><span class="v num">{v.matched}/{v.checked}</span></div>
                <div class="row"><span class="k">Workstreams excluded for a bad citation</span><span class="v num">{(v.company.results.reconciliation?.dropped ?? []).length}</span></div>
                <div class="row"><span class="k">Claims read</span><span class="v num">{f.count(v.claims)}</span></div>
              </div>
              <p class="prose small t-secondary" style="margin:14px 0 0">
                Every quoted figure is matched back against the document it was attributed to. A
                workstream that cites something the filing does not say is excluded whole, not
                corrected. Filing dates are checked twice, once by the adapter and again by the
                chain, and the retrieval window for anything read from the web is bounded at the
                source so nothing published after the lock date can enter at all.
              </p>
            </div>
          </div>

          <div class="panel">
            <div class="panel-head">
              <span class="eyebrow">Not measured</span>
              <span class="plus">+</span>
            </div>
            <div class="panel-body">
              <p class="prose" style="margin:0">
                No accuracy figure on this page has been measured. There is no backtest, the
                weighting is asserted rather than fitted, and the ranges are the weighing step's own
                and have never been checked against an outcome.
              </p>
              <p class="prose small t-secondary" style="margin:12px 0 0">
                For two of the three that is not an omission to be filled in later. Scoring our
                estimate against past results is possible from the filings. Scoring it against the
                Street's figure as it stood at those quarters is not, because no source available
                publishes what consensus was at the time. So a p10 to p90 range here is not a claim
                that four outcomes in five fall inside it.
              </p>
            </div>
          </div>
        </div>
      </section>

      <section class="sheet-section">
        <Strip
          items={[
            { label: "Estimates", value: "3", context: `Three lines for ${v.h.period}.` },
            { label: "Claims read", value: f.count(v.claims), context: "Each carrying the quote it came from." },
            {
              label: "Quotes matched",
              value: `${f.count(v.matched)}/${f.count(v.checked)}`,
              context: "Checked back against the filing text.",
              tone: v.matched === v.checked ? "teal" : "amber",
            },
            { label: "Spend", value: f.usd(v.usd), context: "Measured across this run." },
            {
              label: "Parts running",
              value: String(nodes.length),
              context: `${nodes.filter((n) => n.covered).length} covered by a check.`,
            },
          ]}
        />
      </section>
    </div>
  ))}
</Sheet>
