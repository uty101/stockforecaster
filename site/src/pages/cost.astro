---
import Sheet from "../layouts/Sheet.astro";
import Panel from "../components/Panel.astro";
import Strip from "../components/Strip.astro";
import { companies, header, costByStage, costByAgent, callsOf } from "../lib/read.mjs";
import * as f from "../lib/fmt.mjs";

const BAND = [
  ["input", "#5381A6"],
  ["output", "#A77BFF"],
  ["cacheWrite", "#E0A94A"],
  ["cacheRead", "#35D39A"],
];
const W = 620;
const barW = W - 180;

// One name at a time, so what this sheet counts is what that name consumed.
const view = companies.map((company) => {
  const calls = callsOf(company);
  const totals = calls.reduce(
    (acc, call) => ({
      input: acc.input + (call.input_tokens ?? 0),
      output: acc.output + (call.output_tokens ?? 0),
      cacheWrite: acc.cacheWrite + (call.cache_write_tokens ?? 0),
      cacheRead: acc.cacheRead + (call.cache_read_tokens ?? 0),
      calls: acc.calls + 1,
    }),
    { input: 0, output: 0, cacheWrite: 0, cacheRead: 0, calls: 0 },
  );
  const stageRows = costByStage(company);
  return {
    company,
    h: header(company),
    totals,
    allTokens: totals.input + totals.output + totals.cacheWrite + totals.cacheRead,
    stageRows,
    widest: Math.max(1, ...stageRows.map((r) => r.input + r.output + r.cacheWrite + r.cacheRead)),
    agentRows: costByAgent(company),
    ceiling: company.results.cost?.ceiling_usd ?? 0,
    spent: company.results.cost?.spent_usd ?? 0,
  };
});
---

<Sheet title="Cost" subsystem="Consumption" index="07">
  {view.map((v) => (
    <div data-company={v.company.ticker} hidden>
      <section class="sheet-section">
        <div class="grid2">
          <Panel n="01" name="Input" figure={f.tokens(v.totals.input)} unit="tokens">
            <p>Read into the model across {f.count(v.totals.calls)} calls on this name.</p>
          </Panel>
          <Panel n="02" name="Output" figure={f.tokens(v.totals.output)} unit="tokens">
            <p>Written back. Output carries the higher rate, so it sets most of the total.</p>
          </Panel>
          <Panel n="03" name="Cache write" figure={f.tokens(v.totals.cacheWrite)} unit="tokens">
            <p>The shared prefix stored once so the calls that follow it do not pay full rate.</p>
          </Panel>
          <Panel n="04" name="Cache read" figure={f.tokens(v.totals.cacheRead)} unit="tokens">
            <p>Served from that stored prefix. This is the band that keeps the total down.</p>
          </Panel>
        </div>
      </section>

      <section class="sheet-section">
        <h2 class="section-heading">By stage</h2>
        <div class="panel" style="margin-top:16px">
          <div class="panel-body">
            <svg viewBox={`0 0 ${W} ${v.stageRows.length * 28 + 30}`} width="100%" role="img"
              aria-label="Token consumption by stage, split by kind">
              {v.stageRows.map((row, i) => {
                const y = i * 28 + 8;
                const total = row.input + row.output + row.cacheWrite + row.cacheRead;
                let x = 70;
                return (
                  <g>
                    <text x="0" y={y + 14} class="tick">{row.stage}</text>
                    {BAND.map(([key, colour]) => {
                      const width = (row[key] / v.widest) * barW;
                      const rect = <rect x={x} y={y} width={Math.max(0, width)} height="18" fill="none" stroke={colour} stroke-width="1" />;
                      x += width;
                      return width > 0.4 ? rect : null;
                    })}
                    <text x={x + 8} y={y + 14} class="tick">{f.tokens(total)} · {f.usd(row.usd, 3)}</text>
                  </g>
                );
              })}
            </svg>
            <div class="legend meta">
              {BAND.map(([key, colour]) => (
                <span>
                  <svg width="18" height="8"><rect x="0" y="1" width="17" height="6" fill="none" stroke={colour} stroke-width="1" /></svg>
                  {key === "cacheWrite" ? "cache write" : key === "cacheRead" ? "cache read" : key}
                </span>
              ))}
            </div>
          </div>
        </div>
      </section>

      <section class="sheet-section">
        <h2 class="section-heading">By reader</h2>
        <div class="panel scroll-x" style="margin-top:16px">
          <div class="panel-body">
            <table class="ledger">
              <thead>
                <tr>
                  <th>Reader</th>
                  <th>Model</th>
                  <th class="n">Calls</th>
                  <th class="n">Input</th>
                  <th class="n">Output</th>
                  <th class="n">Cache read</th>
                  <th class="n">Spend</th>
                </tr>
              </thead>
              <tbody>
                {v.agentRows.map((row) => (
                  <tr>
                    <td>{row.agent}</td>
                    <td class="t-secondary">{row.model}</td>
                    <td class="n">{f.count(row.calls)}</td>
                    <td class="n">{f.tokens(row.input)}</td>
                    <td class="n">{f.tokens(row.output)}</td>
                    <td class="n">{f.tokens(row.cacheRead)}</td>
                    <td class="n">{f.usd(row.usd, 3)}</td>
                  </tr>
                ))}
              </tbody>
            </table>
          </div>
        </div>
      </section>

      <section class="sheet-section">
        <Strip
          items={[
            { label: "Spend", value: f.usd(v.spent), context: `Against a ceiling of ${f.usd(v.ceiling)}.` },
            { label: "Headroom", value: f.usd(v.ceiling - v.spent), context: "Left unused under the ceiling.", tone: "teal" },
            { label: "Tokens", value: f.tokens(v.allTokens), context: "Across every call on this name." },
            { label: "Served from cache", value: f.tokens(v.totals.cacheRead), context: "Read from the stored prefix." },
            { label: "Calls", value: f.count(v.totals.calls), context: "Each one recorded with its cost." },
          ]}
        />
      </section>
    </div>
  ))}
</Sheet>

<style>
  .tick { font-size: 10px; fill: var(--faint); font-family: var(--mono); }
  .legend { display: flex; gap: 20px; flex-wrap: wrap; margin-top: 10px; }
  .legend span { display: inline-flex; align-items: center; gap: 6px; }
</style>
