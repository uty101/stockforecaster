---
import Sheet from "../layouts/Sheet.astro";
import Panel from "../components/Panel.astro";
import StatusCard from "../components/StatusCard.astro";
import Strip from "../components/Strip.astro";
import Concepts from "../components/Concepts.astro";
import { companies, header, primary, sum } from "../lib/read.mjs";
import * as f from "../lib/fmt.mjs";

const checked = sum(companies, (c) => c.results.reconciliation?.citations_checked ?? 0);
const matched = sum(companies, (c) => c.results.reconciliation?.citations_matched ?? 0);
const failed = checked - matched;
const rate = checked ? (matched / checked) * 100 : null;

const claims = companies.flatMap((c) => c.results.evidence?.claims ?? []);
const byKind = claims.reduce((acc, claim) => {
  acc[claim.kind ?? "unstated"] = (acc[claim.kind ?? "unstated"] ?? 0) + 1;
  return acc;
}, {});
const documents = sum(companies, (c) => Object.keys(c.results.evidence?.documents ?? {}).length);

const dropped = companies.flatMap((c) =>
  (c.results.reconciliation?.dropped ?? []).map((d) => ({ ticker: c.ticker, ...d })),
);

const requests = companies.flatMap((c) =>
  Object.entries(c.results.integrity?.answered_by ?? {}).map(([request, source]) => ({
    ticker: c.ticker,
    request,
    source,
  })),
);
const answered = requests.filter((r) => r.source).length;

const skipped = companies.flatMap((c) =>
  (c.results.notes ?? [])
    .filter((n) => n.kind === "drop" && n.skipped)
    .map((n) => ({ ticker: c.ticker, ...n })),
);
const skippedTotal = sum(skipped, (s) => s.skipped ?? 0);
const lockDate = header(primary).as_of;
---

<Sheet title="Integrity" subsystem="Verification" index="09">
  <div class="lede-row">
    <div class="lede">
      <span class="bar"></span>
      <p>
        Every figure carries the quote it was read from, and every quote is checked back against the
        document that supplied it. What failed that check is named here.
      </p>
    </div>
    <StatusCard
      name="Verification"
      word={failed === 0 ? "Clean" : "One failed"}
      summary="Quotes matched to their filing"
      tone={failed === 0 ? "teal" : "amber"}
      fill={checked ? matched / checked : 0}
      rows={[
        ["Checked", f.count(checked)],
        ["Matched", f.count(matched)],
        ["Failed", f.count(failed)],
        ["Documents", f.count(documents)],
      ]}
    />
  </div>

  <section class="sheet-section">
    <Concepts
      items={[
        { title: "Quoted", line: "Every figure carries the sentence it was read from." },
        { title: "Matched", line: "Each quote is found again in the document it cites." },
        { title: "Dated", line: "Nothing published after the lock date can enter." },
        { title: "Excluded", line: "A quote that fails takes its workstream out." },
      ]}
    />
  </section>

  <section class="sheet-section">
    <h2 class="section-heading">What was checked</h2>
    <div class="grid2" style="margin-top:16px">
      <Panel n="01" name="Prose" figure={f.count(byKind.prose ?? 0)} unit="claims">
        <p>Read from a sentence in the release. The quote is the sentence, matched word for word.</p>
      </Panel>
      <Panel n="02" name="Structured" figure={f.count(byKind.structured ?? 0)} unit="claims">
        <p>
          Read from a table rather than a sentence. The quote is the row as printed, so a figure taken
          from a table is checked the same way as one taken from prose.
        </p>
      </Panel>
      <Panel n="03" name="Derived" figure={f.count(byKind.derived ?? 0)} unit="claims">
        <p>Stated by the company as a calculated figure. Carried only where the company printed it.</p>
      </Panel>
      <Panel n="04" name="Depth" figure={f.count(documents)} unit="documents">
        <p>Filings, transcripts and slides behind the claims read across the four names.</p>
      </Panel>
    </div>
  </section>

  {dropped.length > 0 && (
    <section class="sheet-section">
      <h2 class="section-heading">What failed</h2>
      <div class="panel scroll-x" style="margin-top:16px">
        <div class="panel-body">
          <table class="ledger">
            <thead>
              <tr><th>Name</th><th>Workstream</th><th>Citation</th><th>Why</th></tr>
            </thead>
            <tbody>
              {dropped.map((row) => (
                <tr>
                  <td>{row.ticker}</td>
                  <td>{String(row.lens ?? "").replace(/^lens_/, "")}</td>
                  <td class="t-secondary">{row.citation_id}</td>
                  <td class="t-secondary">{row.reason}</td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      </div>
    </section>
  )}

  <section class="sheet-section">
    <h2 class="section-heading">Time</h2>
    <div class="grid2" style="margin-top:16px">
      <Panel n="05" name="Lock date" figure={lockDate} unit="nothing later admitted">
        <p>
          Requests are bounded at the source, so a document published after the lock date cannot enter
          the reading. Comparisons against history use the figure as first reported.
        </p>
      </Panel>
      <Panel n="06" name="Restatements" figure={f.count(companies.reduce((n, c) => n + (c.results.model?.metrics ?? []).reduce((m, x) => m + (x.notes ?? []).length, 0), 0))} unit="values set aside">
        <p>
          Where the same figure appears on two scales, the reading is put on one scale or set aside.
          Each one is named on the model sheet rather than silently corrected.
        </p>
      </Panel>
    </div>
  </section>

  <section class="sheet-section">
    <h2 class="section-heading">Which source answered</h2>
    <div class="panel scroll-x" style="margin-top:16px">
      <div class="panel-body">
        <table class="ledger">
          <thead>
            <tr><th>Name</th><th>Request</th><th>Answered by</th></tr>
          </thead>
          <tbody>
            {requests.map((row) => (
              <tr>
                <td>{row.ticker}</td>
                <td class="t-secondary">{row.request}</td>
                <td>
                  {row.source ? (
                    <span class="state source">{row.source}</span>
                  ) : (
                    <span class="state open">no source</span>
                  )}
                </td>
              </tr>
            ))}
          </tbody>
        </table>
        <p class="meta" style="margin:12px 0 0">
          A request with no source is stated as unanswered. No figure was substituted for one.
        </p>
      </div>
    </div>
  </section>

  {skipped.length > 0 && (
    <section class="sheet-section">
      <h2 class="section-heading">What was not read</h2>
      <div class="panel" style="margin-top:16px">
        <div class="panel-body">
          <table class="ledger">
            <thead>
              <tr><th>Name</th><th>Set</th><th class="n">Skipped</th><th>Why</th></tr>
            </thead>
            <tbody>
              {skipped.map((row) => (
                <tr>
                  <td>{row.ticker}</td>
                  <td>{row.acquirer}</td>
                  <td class="n">{f.count(row.skipped)}</td>
                  <td class="t-secondary">{row.reason}</td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      </div>
    </section>
  )}

  <section class="sheet-section">
    <Strip
      items={[
        { label: "Checked", value: f.count(checked), context: "Quotes matched back to a document." },
        { label: "Failed", value: f.count(failed), context: "Quote not found in the filing cited.", tone: failed ? "red" : "teal" },
        { label: "Verification rate", value: rate === null ? "—" : f.pct(rate), context: "Across the four names.", tone: "teal" },
        { label: "Requests answered", value: `${answered}/${requests.length}`, context: "The rest are stated as unanswered." },
        { label: "Documents skipped", value: f.count(skippedTotal), context: "Left unread when the budget ran out.", tone: "amber" },
      ]}
    />
  </section>
</Sheet>
