---
import Sheet from "../layouts/Sheet.astro";
import Panel from "../components/Panel.astro";
import StatusCard from "../components/StatusCard.astro";
import Strip from "../components/Strip.astro";
import { companies, header, primary } from "../lib/read.mjs";
import * as f from "../lib/fmt.mjs";

const method = primary.results.method ?? {};
const backtest = method.backtest ?? {};

// The sample that does exist: reported periods rebuilt from history alone.
const reproduced = companies.flatMap((c) =>
  (c.results.model?.metrics ?? []).flatMap((m) =>
    (m.reproduction ?? []).map((r) => ({ ticker: c.ticker, metric: m.metric, ...r })),
  ),
);
const sample = reproduced.length;
const errors = reproduced.map((r) => r.error_pct).filter((n) => typeof n === "number");
const within5 = errors.filter((n) => Math.abs(n) < 5).length;

const byName = companies.map((c) => {
  const rows = (c.results.model?.metrics ?? []).map((m) => m.reproduction_error).filter((n) => typeof n === "number");
  const worst = rows.length ? rows.reduce((a, b) => (Math.abs(a) > Math.abs(b) ? a : b)) : null;
  return { ticker: c.ticker, worst };
});
const widest = Math.max(1, ...byName.map((b) => Math.abs(b.worst ?? 0)));

const W = 520;
const barH = 22;
---

<Sheet title="Method" subsystem="Measurement" index="06">
  <div class="lede-row">
    <div class="lede">
      <span class="bar"></span>
      <p>
        What has been measured and what has not. The error against periods already reported is
        measured. Skill against the Street is not, and the sheet says so rather than estimating it.
      </p>
    </div>
    <StatusCard
      name="Sample"
      word={sample >= 30 ? "Sufficient" : "Thin"}
      summary="Reported periods rebuilt from history"
      tone={sample >= 30 ? "teal" : "amber"}
      fill={Math.min(1, sample / 30)}
      rows={[
        ["Periods rebuilt", String(sample)],
        ["Within 5 points", `${within5}/${sample}`],
        ["Scored against the Street", String(backtest.runs ?? 0)],
      ]}
    />
  </div>

  <section class="sheet-section">
    <div class="grid2">
      <Panel n="01" name="Power" figure={String(sample)} unit="periods in the sample">
        <p>
          A sample of {sample} rebuilt periods supports a statement about how far the history model
          sits from what was printed. The sample needed to separate skill from noise against the
          Street cannot be stated, because no scored comparison exists.
        </p>
      </Panel>
      <Panel n="02" name="Skill against the Street" figure="—" unit="not measured">
        <p>{backtest.why ?? "No scored comparison against the Street exists for this run."}</p>
      </Panel>
    </div>
  </section>

  <section class="sheet-section">
    <h2 class="section-heading">Error against reported periods</h2>
    <div class="panel" style="margin-top:16px">
      <div class="panel-body">
        <svg viewBox={`0 0 ${W} ${byName.length * (barH + 10) + 20}`} width="100%" role="img"
          aria-label="Widest reproduction error by name">
          {byName.map((row, i) => {
            const y = i * (barH + 10) + 8;
            const width = row.worst === null ? 0 : (Math.abs(row.worst) / widest) * (W - 150);
            return (
              <g>
                <text x="0" y={y + 14} class="tick">{row.ticker}</text>
                <rect x="50" y={y} width={Math.max(1, width)} height={barH} fill="none"
                  stroke={Math.abs(row.worst ?? 0) < 5 ? "#35D39A" : "#E0A94A"} stroke-width="1" />
                <text x={56 + Math.max(1, width)} y={y + 15} class="tick">
                  {f.signedPctPoints(row.worst)}
                </text>
              </g>
            );
          })}
        </svg>
        <p class="small t-secondary" style="margin:6px 0 0">
          Widest error for each name between the rebuilt figure and the figure the company printed.
        </p>
      </div>
    </div>
  </section>

  <section class="sheet-section">
    <div class="grid2">
      <div class="panel">
        <div class="panel-head">
          <span class="eyebrow">Calibration</span>
          <span class="plus">+</span>
        </div>
        <div class="panel-body">
          <svg viewBox="0 0 260 200" width="100%" role="img" aria-label="Stated confidence against realised outcomes">
            <line x1="30" y1="170" x2="240" y2="170" stroke="#1A2230" stroke-width="1" />
            <line x1="30" y1="20" x2="30" y2="170" stroke="#1A2230" stroke-width="1" />
            <line x1="30" y1="170" x2="240" y2="20" stroke="#79899C" stroke-width="0.5" stroke-dasharray="4 4" />
            <text x="150" y="96" class="tick" transform="rotate(-27 150 96)">stated equals realised</text>
            <text x="30" y="190" class="tick">0</text>
            <text x="232" y="190" class="tick">1</text>
          </svg>
          <p class="small t-secondary" style="margin:6px 0 0">
            Not yet calibrated against realised outcomes. The line is where points will sit once the
            quarters print.
          </p>
        </div>
      </div>

      <div class="panel">
        <div class="panel-head">
          <span class="eyebrow">Contribution</span>
          <span class="plus">+</span>
        </div>
        <div class="panel-body">
          <p class="small t-secondary" style="margin:0">
            No workstream has been removed and the estimate rescored, so the contribution of each one
            is unmeasured. Dispersion between workstreams stands in its place on sheet 03.
          </p>
        </div>
      </div>
    </div>
  </section>

  <section class="sheet-section">
    <h2 class="section-heading">Fitted parameters</h2>
    <div class="panel scroll-x" style="margin-top:16px">
      <div class="panel-body">
        <table class="ledger">
          <thead>
            <tr>
              <th>Name</th>
              <th>Line</th>
              <th class="n">Growth rate</th>
              <th class="n">Weight</th>
              <th class="n">Sample</th>
              <th class="n">Spread</th>
            </tr>
          </thead>
          <tbody>
            {companies.flatMap((c) =>
              (c.results.model?.metrics ?? []).map((m) => (
                <tr>
                  <td>{c.ticker}</td>
                  <td>{m.metric}</td>
                  <td class="n">{f.pct((m.growth?.shrunk ?? 0) * 100)}</td>
                  <td class="n">{f.ratio(m.growth?.shrinkage_weight)}</td>
                  <td class="n">{f.count(m.growth?.observations)}</td>
                  <td class="n">{f.ratio(m.growth?.scaled_mad)}</td>
                </tr>
              )),
            )}
          </tbody>
        </table>
        <p class="meta" style="margin:12px 0 0">
          Weight is how far the trailing rate is trusted against the prior. Spread is the dispersion of
          the series it was fitted on.
        </p>
      </div>
    </div>
  </section>

  <section class="sheet-section">
    <Strip
      items={[
        { label: "Periods rebuilt", value: String(sample), context: "The measured sample." },
        { label: "Within 5 points", value: `${within5}/${sample}`, context: "Rebuilt close to the printed figure.", tone: "teal" },
        { label: "Scored vs Street", value: String(backtest.runs ?? 0), context: "No consensus history to score against.", tone: "amber" },
        { label: "Versions", value: String(Object.keys(method.prompt_versions ?? {}).length), context: "Readers with a recorded version." },
      ]}
    />
  </section>
</Sheet>

<style>
  .tick { font-size: 10px; fill: var(--faint); font-family: var(--mono); }
</style>
