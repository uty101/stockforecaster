---
// The whole route from filing to estimate, drawn as a circuit.
//
// Geometry is computed from the node registry, so a component added to the run
// appears here without anyone drawing it. Edge weight and speed come from the
// number of verified claims each route carried on this run.
import { nodes as allNodes, nodeLoad, lensRows, tickerId } from "../lib/read.mjs";

const { company } = Astro.props;
const results = company.results;
const id = tickerId(company.ticker);
const load = nodeLoad(company);
const lenses = lensRows(company);
const lensByNode = new Map(lenses.map((l) => [l.node_id, l]));

// What the box says. A name, never more than two words, so the drawing reads as
// a circuit at a glance. The registry label, the line of description and the
// run figures all live behind a click. Anything absent falls back to the
// registry label.
const TITLES = {
  J1: "Corpus",
  J2: "Consensus",
  J3: "News",
  J5: "Universe",
  J6: "Macro feed",
  J7: "Sponsor feed",
  U1: "Numbers",
  U2: "Series",
  U3: "Filings",
  U4: "Ranges",
  U5: "Industry",
  U6: "Macro series",
  U7: "Bridge",
  U8: "Calls",
  U9: "Perception",
  U10: "Evidence",
  U11: "Income model",
  U12: "Mechanical",
  U13: "Guidance",
  U14: "Drivers",
  U15: "Demand",
  U16: "Market",
  U17: "Margins",
  U18: "Forensics",
  U19: "Peer read",
  U20: "Macro",
  U21: "Reconcile",
  U22: "Champion",
  U23: "Judge",
  U24: "Comparability",
  U26: "Position",
  OUT: "Estimate",
};

// One line under each name, in the language of the desk rather than the build.
const SAYS = {
  J1: "Filings, transcripts and slides",
  J2: "Street estimates and coverage",
  J3: "Trade press, date bounded",
  J5: "The four names in scope",
  J6: "Macro series, vintage pinned",
  J7: "The metric, unit and period we owe",
  U1: "Reported figures, each with its quote",
  U2: "The reported series by period",
  U3: "Filings pulled for the period",
  U4: "Guided ranges as issued",
  U5: "Industry reading around the quarter",
  U6: "The series this company turns on",
  U7: "Statutory to adjusted bridge",
  U8: "What management said on the call",
  U9: "How the quarter is being read",
  U10: "Every claim, quote and filing",
  U11: "Trailing history and its error",
  U12: "Extrapolation from the reported series",
  U13: "The guided range and its history",
  U14: "Volume, price and mix",
  U15: "Customer and supplier demand",
  U16: "Where the Street sits",
  U17: "Margin path and operating leverage",
  U18: "Accruals and cash conversion",
  U19: "What comparables have printed",
  U20: "Rates, currency and input costs",
  U21: "Every quote checked against its filing",
  U22: "The strongest case, then the case against",
  U23: "Weighs the surviving work into one range",
  U24: "Whether the base year still compares",
  U26: "The figure submitted",
  OUT: "The estimate and its write up",
};

// What each box is for. SAYS is the one line on the drawing; WORTH is why the
// box is in the system at all, which is the question a reader actually has when
// they select it. Kept here beside the drawing rather than in the pipeline,
// because it is a claim about design rather than a figure from the run.
const WORTH = {
  J1: "The filings are the only source that cannot be revised under us. Everything a workstream quotes has to exist in one of these documents, so the whole evidence trail terminates in text a reader can open.",
  J2: "Consensus is the number our error is divided by when this is scored, so it belongs on every page as the comparison. It never feeds the estimate. Serving current figures only, it refuses a historical date rather than answering with today's estimates for a past quarter, which would look like skill.",
  J3: "The corpus holds what the company said about itself and nothing about the market it sells into. Bounding the retrieval window at the source means an article published after the lock date cannot enter the reading at all, rather than being filtered out afterwards.",
  J5: "The four names are fixed by the organisers, so there is no selection to make and no survivorship to guard against. Worth stating because a universe you choose is the easiest place to manufacture a result.",
  J6: "Macro data feels like background rather than a document, which is exactly why it is easy to forget it gets revised. Pinning the vintage to the lock date applies the same rule the filings get to the one source where breaking it would be invisible.",
  J7: "The metric label, unit and period come from the organisers rather than from us. It is what stops an estimate being written against the wrong line, in the wrong unit, for the wrong period.",
  U1: "Turns prose into figures that carry their own quote. A number without the sentence it came from cannot be checked later, and this is where that link is made rather than assumed.",
  U2: "The reported series by period, held apart from the claim store. The trailing history has to be uninterrupted to measure anything from, and a series assembled out of claims has gaps wherever a quote failed.",
  U3: "Picks the results release by its form rather than by its date. A large filer publishes many filings a quarter covering board changes and share dealings, so taking the most recent by date reliably misses the only one that matters.",
  U4: "Guidance is the company's own statement of what it expects, which is the strongest single piece of evidence available before a print. Reading only the most recent release keeps a stale range, issued for a quarter already reported, out of the reading.",
  U5: "The industry is where the revenue and cost lines actually come from. Searching for the driver rather than the company is what separates measurement of the end market from commentary about the share price.",
  U6: "Gives the macro workstream something measured to argue from. Without it that workstream is reasoning from whatever the company chose to say about its own conditions.",
  U7: "An item excluded once is a one off. The same item excluded four periods running is a permanent cost moved below the line, and this reconciliation is the only place that pattern is visible.",
  U8: "Reads the calls as a sequence rather than one at a time. A metric management used to give every quarter and has stopped giving is said by nobody, so it cannot be found in any single call.",
  U9: "Reads how the quarter is being framed, and is deliberately kept away from every revenue and cost driver. Sentiment feeding a revenue line is how a forecast ends up restating the loudest recent headline.",
  U10: "One body of evidence that every workstream reads, so two of them agreeing is a real agreement rather than an artefact of having read different things. Every claim carries an identifier a quote can be checked against.",
  U11: "States its own measured error before anyone trusts it with a projection. Re running recent periods from only what was known before each one turns the model's bias from an opinion into a number.",
  U12: "Arithmetic on the reported series, with no model behind it. It costs nothing, it cannot invent anything, and it is the one reading still standing when the interface to the models is unavailable, which happened during this build.",
  U13: "The guided range plus where this company has historically landed inside it. Everybody reads the guidance. Almost nobody measures the landing position, and it is the cheapest real edge available.",
  U14: "Breaks the line into the quantities that generate it, so the estimate can be wrong in a way somebody can point at. A decomposition that cannot be falsified is not a decomposition.",
  U15: "A customer's spending plans are this company's revenue, and they are disclosed on a different calendar, often earlier. Reading one link up and one link down finds that before the company reports it.",
  U16: "Separates market growth from share change. Consensus forecasts them as one number and almost never splits them, which is the whole reason this reading exists.",
  U17: "Works the margin from prior year actuals and the Street's revenue figure, never from the drivers reading. If the two agreed by construction, the weighing step would read it as two independent views corroborating each other.",
  U18: "Looks for the gap between what is reported and what is earned. Accruals, working capital and what the company chooses to exclude are where a number is dressed rather than made.",
  U19: "A comparable that has already printed into the same window says something about the end market before this company speaks. It abstains rather than reaching across to an unrelated business.",
  U20: "Asks what the estimates in front of us appear to assume about rates, currency and input costs, and whether the series bear that out.",
  U21: "The gate every reading passes through, and it has no model in it on purpose. Nothing that can invent a quote decides which quotes survive. A reading that cites something its filing does not say is excluded whole, because it has told you something about the rest of its reasoning.",
  U22: "Every case is argued against before anything is compared. Comparing raw findings and taking the plurality rewards the finding that was easiest to reach, not the one that matters, and the confidence that survives the attack is the one that counts.",
  U23: "The one place the whole picture is visible, which is why it is the only expensive call and why exactly one is allowed. It weighs by how much each view would move the number, never by how many agreed, and it is told which readings are missing so silence is not mistaken for agreement.",
  U24: "Asks whether this period can be compared with the company's own history at all. When an acquisition, an accounting change, an extra week or withdrawn guidance fires, the priors this system runs on stop applying, and a system most confident where its priors have broken is worse than one that says so.",
  U26: "Where the submitted figure is set. Positioning toward consensus is switched off here by configuration, and every condition that would have moved it is still measured and reported, so the page shows what was declined rather than only what was done.",
  OUT: "The results file and the tape, written so that nothing between the run and the page interprets anything. The write up may not introduce a figure the run did not produce, and that is enforced rather than asked for.",
};

const KIND_TONE = {
  source: "blue",
  agent: "violet",
  deterministic: "teal",
  acquire: "teal",
  gate: "teal",
  output: "teal",
};
const COLOUR = { teal: "#35D39A", violet: "#A77BFF", red: "#FF4D5E", amber: "#E0A94A", blue: "#5381A6", line: "#1A2230" };

// The one node the estimate turns on.
const CONSEQUENCE = "U23";

const COLUMNS = [
  ["A", "sources"],
  ["B", "acquire"],
  ["C", "evidence"],
  ["D", "history"],
  ["E", "workstreams"],
  ["V1", "citations"],
  ["F", "challenge"],
  ["G", "weighting"],
  ["V2", "comparability"],
  ["H", "position"],
  ["I", "output"],
];

// V3 sits on the comparison rail rather than in the column run.
const RAIL_NODE = "U25";
const columnOf = (node) => (node.id === RAIL_NODE ? null : node.stage === "V3" ? "H" : node.stage);

const BOX_W = 128;
const BOX_H = 34;
const COL_GAP = 40;
const ROW_GAP = 16;
const TOP = 56;

const grouped = COLUMNS.map(([letter, name]) => ({
  letter,
  name,
  items: allNodes.filter((n) => columnOf(n) === letter),
}));

const tallest = Math.max(...grouped.map((g) => g.items.length));
const bodyH = tallest * (BOX_H + ROW_GAP);
const railY = TOP + bodyH + 54;
const HEIGHT = railY + 54;
const WIDTH = COLUMNS.length * (BOX_W + COL_GAP);

const pos = new Map();
grouped.forEach((group, ci) => {
  const x = ci * (BOX_W + COL_GAP);
  const total = group.items.length;
  const offset = (bodyH - total * (BOX_H + ROW_GAP)) / 2;
  group.items.forEach((node, ri) => {
    pos.set(node.id, {
      x,
      y: TOP + offset + ri * (BOX_H + ROW_GAP),
      cx: x + BOX_W / 2,
      cy: TOP + offset + ri * (BOX_H + ROW_GAP) + BOX_H / 2,
      col: ci,
    });
  });
  group.x = x;
});

// The rail node sits in series on the comparison conductor, when the registry
// carries it. With no such node the rail runs unbroken rather than showing a
// gap where a box used to be.
const railNodePresent = allNodes.some((n) => n.id === RAIL_NODE);
const railX = WIDTH / 2 - BOX_W / 2;
if (railNodePresent) {
  pos.set(RAIL_NODE, {
    x: railX,
    y: railY - BOX_H / 2,
    cx: WIDTH / 2,
    cy: railY,
    col: -1,
  });
}

const toneOf = (node) => {
  if (node.id === CONSEQUENCE) return "red";
  return KIND_TONE[node.kind] ?? "teal";
};

// Claim volume per route, read from the run.
const claimCount = (results.evidence?.claims ?? []).length;
const guidanceCount = (results.evidence?.guidance ?? []).length;
const checked = results.reconciliation?.citations_checked ?? 0;

function volumeOf(sourceId) {
  const lens = lensByNode.get(sourceId);
  if (lens) return lens.dropped ? 0 : lens.citations;
  const row = load.get(sourceId);
  if (sourceId === "U10") return checked;
  if (sourceId === "U1") return claimCount;
  if (sourceId === "U4") return guidanceCount;
  if (row?.calls) return row.calls;
  return 1;
}

// Every route on the drawing. Volume decides width and speed; a dropped source
// is drawn open rather than absent.
const edges = [];
const push = (from, to, opts = {}) => {
  if (!pos.has(from) || !pos.has(to)) return;
  edges.push({ from, to, ...opts });
};

const sources = allNodes.filter((n) => n.stage === "A");
const acquire = allNodes.filter((n) => n.stage === "B");
const lensNodes = allNodes.filter((n) => n.stage === "E");

for (const s of sources) push(s.id, "U1", { rail: "B", off: !s.available });
for (const a of acquire) push(a.id, "U10", { rail: "C", off: !a.available });
push("U10", "U11");
for (const l of lensNodes) {
  const view = lensByNode.get(l.id);
  push("U10", l.id, { rail: "E", dropped: view?.dropped, volume: volumeOf(l.id) });
}
for (const l of lensNodes) {
  const view = lensByNode.get(l.id);
  push(l.id, "U21", { rail: "V1", dropped: view?.dropped, volume: volumeOf(l.id) });
}
push("U11", "U12", { volume: claimCount });
push("U21", "U22");
push("U22", "U23");
push("U23", "U24");
push("U24", "U26");
push("U26", "OUT");

const volumes = edges.map((e) => e.volume ?? 1).filter((v) => v > 0);
const maxV = Math.max(1, ...volumes);
const minV = Math.min(...volumes, maxV);

// Busiest route completes a cycle in 1.1s, quietest in 2.8s.
function shape(edge) {
  const v = edge.volume ?? minV;
  const t = maxV === minV ? 1 : (v - minV) / (maxV - minV);
  return {
    width: (1 + t * 1.5).toFixed(2),
    seconds: (2.8 - t * 1.7).toFixed(2),
  };
}

// Where many routes meet one collector, they run onto a vertical rail rather
// than crossing each other.
function path(edge) {
  const a = pos.get(edge.from);
  const b = pos.get(edge.to);
  const x1 = a.x + BOX_W;
  const x2 = b.x;
  const mid = x1 + (x2 - x1) / 2;
  if (Math.abs(a.cy - b.cy) < 1) return `M${x1} ${a.cy} H${x2}`;
  return `M${x1} ${a.cy} H${mid} V${b.cy} H${x2}`;
}

const flowing = edges.filter((e) => !e.dropped && !e.off);
// Above forty simultaneous routes the quietest lose the overlay, not everything.
const animated = new Set(
  flowing
    .map((e, i) => ({ i, v: e.volume ?? 1 }))
    .sort((a, b) => b.v - a.v)
    .slice(0, 40)
    .map((e) => e.i),
);

// What a selected box says. Two things only: what it is, and why it is here.
// The run figures for every node are on the Agents and Cost sheets, and putting
// them in here as well made a card nobody finished reading.
const detail = Object.fromEntries(
  allNodes.map((n) => [
    n.id,
    {
      title: TITLES[n.id] ?? n.label,
      label: n.label,
      says: SAYS[n.id] ?? n.note ?? "",
      worth: WORTH[n.id] ?? "",
    },
  ]),
);

const busTap = results.forecast?.consensus_bus?.tapped_at_node ?? "U1";
---

<div class="flowwrap" data-flow={id}>
  <div class="flowtoggles">
    <div class="toggle">
      <span class="eyebrow">Routes</span>
      <label><input type="radio" name={`view-${id}`} value="data" checked /> <span>evidence</span></label>
      <label><input type="radio" name={`view-${id}`} value="acct" /> <span>checked by</span></label>
    </div>
    <div class="toggle">
      <span class="eyebrow">Boxes</span>
      <span class="hint">Select one for what it is and why it is here</span>
    </div>
  </div>

  <div class="legend meta">
    <span><svg width="26" height="6"><path d="M0 3 H26" stroke="#35D39A" stroke-width="1.6" /></svg> reported and checked</span>
    <span><svg width="26" height="6"><path d="M0 3 H26" stroke="#A77BFF" stroke-width="1.6" /></svg> written by a reader</span>
    <span><svg width="26" height="6"><path d="M0 3 H26" stroke="#FF4D5E" stroke-width="1" stroke-dasharray="3 3" /></svg> excluded, carries nothing</span>
    <span><svg width="26" height="6"><path d="M0 3 H26" stroke="#4E5C6E" stroke-width="1" stroke-dasharray="3 3" /></svg> not answered</span>
  </div>

  <div class="scroll-x">
    <svg class="flow" viewBox={`0 0 ${WIDTH} ${HEIGHT}`} width={WIDTH} height={HEIGHT} role="img"
      aria-label="The route from filing to estimate">
      {grouped.map((group) => (
        <text x={group.x} y="20" class="collabel">{group.letter} · {group.name}</text>
      ))}

      {/* The gate every route passes through. */}
      <rect
        class="gate"
        x={pos.get("U21").x - 14}
        y={TOP - 12}
        width={BOX_W + 28}
        height={bodyH + 12}
        fill="none"
        stroke="#243040"
        stroke-width="1"
        stroke-dasharray="4 6"
      />

      <g class="edges edges-data">
        {edges.map((edge, i) => {
          const s = shape(edge);
          const d = path(edge);
          const end = pos.get(edge.to);
          if (edge.dropped) {
            return (
              <g>
                <path d={d} class="edge-dropped" fill="none" stroke="#FF4D5E" stroke-width="1" stroke-dasharray="3 3" />
                <path
                  d={`M${end.x - 9} ${end.cy - 4} L${end.x - 1} ${end.cy + 4} M${end.x - 1} ${end.cy - 4} L${end.x - 9} ${end.cy + 4}`}
                  stroke="#FF4D5E"
                  stroke-width="1"
                  fill="none"
                />
              </g>
            );
          }
          if (edge.off) {
            return <path d={d} fill="none" stroke="#1A2230" stroke-width="1" opacity="0.3" />;
          }
          const tone = lensByNode.has(edge.from) || lensByNode.has(edge.to) ? "#A77BFF" : "#35D39A";
          return (
            <g>
              <path d={d} fill="none" stroke="#1A2230" stroke-width={s.width} />
              {animated.has(i) && (
                <path
                  d={d}
                  class="flowline"
                  fill="none"
                  stroke={tone}
                  stroke-width={s.width}
                  stroke-dasharray="6 10"
                  style={`--cycle:${s.seconds}s`}
                />
              )}
            </g>
          );
        })}
      </g>

      {/* Which reading is checked by which. Same drawing, different routes. */}
      <g class="edges edges-acct">
        {[["U21", "U10"], ["U24", "U23"], ["U22", "U23"], ["U11", "U12"], ["U25", "U26"]].map(([a, b]) => {
          const from = pos.get(a);
          const to = pos.get(b);
          if (!from || !to) return null;
          return (
            <path
              d={`M${from.cx} ${from.y + BOX_H} C ${from.cx} ${from.y + BOX_H + 40}, ${to.cx} ${to.y + BOX_H + 40}, ${to.cx} ${to.y + BOX_H}`}
              fill="none"
              stroke="#E0A94A"
              stroke-width="1"
              stroke-dasharray="2 4"
            />
          );
        })}
      </g>

      {/* The comparison rail. Fixed speed, its own conductor, touched by nothing. */}
      <path
        class="bus"
        d={`M${pos.get(busTap)?.cx ?? 0} ${pos.get(busTap)?.y + BOX_H} V${railY} H${railNodePresent ? railX : pos.get("U26").cx}${railNodePresent ? "" : ` V${pos.get("U26").y + BOX_H}`}`}
        fill="none"
        stroke="#35D39A"
        stroke-width="2"
      />
      {railNodePresent && (
        <path
          class="bus"
          d={`M${railX + BOX_W} ${railY} H${pos.get("U26").cx} V${pos.get("U26").y + BOX_H}`}
          fill="none"
          stroke="#35D39A"
          stroke-width="2"
        />
      )}
      <text x={railX} y={railY + 40} class="busnote">
        Street consensus, taken once at {busTap} and carried to the position. Nothing in the reading can move it.
      </text>

      {allNodes.map((node) => {
        const p = pos.get(node.id);
        if (!p) return null;
        const tone = toneOf(node);
        const dashed = !node.available || node.kind === "advisory";
        const title = TITLES[node.id] ?? node.label;
        return (
          <g
            class="node"
            data-node={node.id}
            tabindex="0"
            role="button"
            aria-label={`${title}. ${SAYS[node.id] ?? ""}`}
          >
            <text x={p.x} y={p.y - 5} class="nodeid">{node.id}</text>
            {/* Solid fill: a route runs behind a box, never through it. */}
            <rect
              x={p.x}
              y={p.y}
              width={BOX_W}
              height={BOX_H}
              rx="3"
              class="nodebox"
              stroke={dashed ? "#4E5C6E" : COLOUR[tone]}
              stroke-width="1"
              stroke-dasharray={dashed ? "3 3" : undefined}
            />
            <text
              x={p.cx}
              y={p.y + BOX_H / 2 + 4}
              class="nodename"
              text-anchor="middle"
              fill={dashed ? "#4E5C6E" : COLOUR[tone]}
            >
              {title}
            </text>
          </g>
        );
      })}
    </svg>

    {/* Opens against the box that was selected, inside the drawing's own
        scrolling area, so it stays where the reader is looking. */}
    <div class="nodecard" data-card hidden>
      <div class="nodecard-head">
        <span class="nodecard-id" data-card-id></span>
        <span class="nodecard-name" data-card-name></span>
      </div>
      <p class="nodecard-says" data-card-says></p>
      <p class="nodecard-worth" data-card-worth></p>
    </div>
  </div>

  <script type="application/json" data-flow-detail set:html={JSON.stringify(detail)}></script>
</div>

<style>
  .flowwrap { margin-top: 16px; }
  .flowtoggles { display: flex; gap: 32px; flex-wrap: wrap; margin-bottom: 10px; }
  .toggle { display: flex; align-items: center; gap: 10px; }
  .toggle label { display: inline-flex; align-items: center; gap: 5px; font-size: 11px; color: var(--secondary); cursor: pointer; }
  .toggle input { accent-color: #a77bff; width: 10px; height: 10px; }
  .toggle .hint { font-size: 11px; color: var(--secondary); }
  .legend { display: flex; gap: 22px; flex-wrap: wrap; font-size: 9.5px; letter-spacing: 0.08em; margin-bottom: 12px; }
  .legend span { display: inline-flex; align-items: center; gap: 7px; }

  svg.flow { display: block; }
  .collabel { font-size: 9.5px; letter-spacing: 0.14em; text-transform: uppercase; fill: var(--faint); font-family: var(--mono); }
  .nodeid { font-size: 8.5px; fill: var(--faint); font-family: var(--mono); }
  .nodename { font-size: 11.5px; font-family: var(--mono); }
  .busnote { font-size: 9.5px; fill: var(--faint); font-family: var(--mono); }

  /* A box is a solid object on the board: routes pass behind it, not through. */
  .nodebox { fill: var(--raised); transition: fill 160ms linear, stroke 240ms linear; }

  .node { cursor: pointer; }
  .node:hover .nodebox { fill: #131c27; stroke-width: 1.5; }
  /* The browser's own focus ring is a white rectangle around the group, which
     reads as a rendering fault rather than a selection. Drawn here instead. */
  .node:focus { outline: none; }
  .node:focus-visible .nodebox { stroke: #35d39a; stroke-width: 2; }
  .node.is-open .nodebox { fill: #16202c; stroke-width: 2; stroke-dasharray: none; }
  .node.is-open .nodeid { fill: var(--body); }

  .edges-acct { display: none; }
  .flowwrap:has(input[value="acct"]:checked) .edges-acct { display: block; }
  .flowwrap:has(input[value="acct"]:checked) .edges-data .flowline { display: none; }

  /* Current. Only the dash offset moves. */
  @keyframes current { to { stroke-dashoffset: -16; } }
  .flowline { animation: current var(--cycle, 2s) linear infinite; }
  .bus { animation: current 2.2s linear infinite; stroke-dasharray: 6 10; }
  .gate { animation: gatecurrent 6s linear infinite; }
  @keyframes gatecurrent { to { stroke-dashoffset: -20; } }

  /* The card opens against the box that was selected. It lives inside the
     drawing's own scrolling area, so it travels with the drawing rather than
     answering a click somewhere the reader is not looking. */
  .scroll-x { position: relative; }
  .nodecard {
    position: absolute;
    z-index: 4;
    width: 250px;
    padding: 11px 13px 12px;
    border: 1px solid var(--teal);
    background: var(--panel);
    box-shadow: 0 10px 26px -12px #000;
  }
  .nodecard[hidden] { display: none; }
  .nodecard-head { display: flex; align-items: baseline; gap: 7px; margin-bottom: 6px; }
  .nodecard-id { font-family: var(--mono); font-size: 8.5px; letter-spacing: 0.12em; color: var(--faint); }
  .nodecard-name { font-family: var(--mono); font-size: 12px; color: var(--teal); }
  .nodecard-says { margin: 0; font-size: 11px; line-height: 1.5; color: var(--secondary); }
  .nodecard-worth { margin: 8px 0 0; font-size: 11.5px; line-height: 1.6; color: var(--body); }
  .nodecard-worth:empty { display: none; }

  @media (prefers-reduced-motion: reduce) {
    .flowline, .bus, .gate { animation: none; }
  }
</style>

<script>
  // Open a box, put the card beside it, and get out of the way on the next click.
  for (const wrap of document.querySelectorAll("[data-flow]")) {
    const detail = JSON.parse(wrap.querySelector("[data-flow-detail]").textContent);
    const stage = wrap.querySelector(".scroll-x");
    const card = wrap.querySelector("[data-card]");
    const cardId = wrap.querySelector("[data-card-id]");
    const cardName = wrap.querySelector("[data-card-name]");
    const cardSays = wrap.querySelector("[data-card-says]");
    const cardWorth = wrap.querySelector("[data-card-worth]");
    const boxes = [...wrap.querySelectorAll("[data-node]")];
    const GAP = 12;
    let openId = null;

    const close = () => {
      openId = null;
      card.hidden = true;
      for (const box of boxes) box.classList.remove("is-open");
    };

    // Measured from the live boxes rather than from the geometry that drew them,
    // so the card lands correctly whatever the drawing has been scaled to.
    const place = (node) => {
      // The box itself, not the group, which also carries the ID above it.
      const box = (node.querySelector("rect") ?? node).getBoundingClientRect();
      const area = stage.getBoundingClientRect();
      const left = box.left - area.left + stage.scrollLeft;
      const top = box.top - area.top + stage.scrollTop;
      const width = card.offsetWidth;
      const height = card.offsetHeight;
      const room = stage.scrollWidth - (left + box.width);

      // To the right of the box, unless the drawing runs out of room there.
      const x = room > width + GAP ? left + box.width + GAP : left - width - GAP;
      const y = top + box.height / 2 - height / 2;
      card.style.left = `${Math.max(0, Math.min(x, stage.scrollWidth - width))}px`;
      card.style.top = `${Math.max(0, Math.min(y, stage.scrollHeight - height))}px`;
    };

    const open = (id, node) => {
      const d = detail[id];
      if (!d) return;
      // Selecting the open box again puts the card away.
      if (openId === id) return close();
      openId = id;
      for (const box of boxes) box.classList.toggle("is-open", box.dataset.node === id);
      cardId.textContent = id;
      cardName.textContent = d.title;
      cardSays.textContent = d.says || d.label;
      cardWorth.textContent = d.worth || "";
      card.hidden = false;
      place(node);
    };

    for (const node of boxes) {
      node.addEventListener("click", (event) => {
        event.stopPropagation();
        open(node.dataset.node, node);
      });
      node.addEventListener("keydown", (event) => {
        if (event.key === "Enter" || event.key === " ") {
          event.preventDefault();
          open(node.dataset.node, node);
        }
      });
    }

    // Anywhere else on the page, and Escape, put it away.
    card.addEventListener("click", (event) => event.stopPropagation());
    document.addEventListener("click", () => { if (openId) close(); });
    document.addEventListener("keydown", (event) => {
      if (event.key === "Escape" && openId) close();
    });
    // A card measured against a box that has since moved is worse than no card.
    window.addEventListener("resize", () => { if (openId) close(); });
  }
</script>
