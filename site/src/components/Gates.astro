---
// What separates a measured figure from a stated one. Every value here is read
// out of the run and the checks; nothing in it is typed by hand.
import { gates, nodes, prompts, testRun } from "../lib/read.mjs";
import Strip from "./Strip.astro";

const { company } = Astro.props;
const rows = gates(company);
const passed = rows.filter((r) => r.state === "pass").length;

const covered = nodes.filter((n) => n.covered).length;
const wired = nodes.length - covered;
const agents = prompts.length;
const tiers = prompts.reduce((acc, p) => {
  acc[p.tier] = (acc[p.tier] ?? 0) + 1;
  return acc;
}, {});
const tierLine = ["cheap", "mid", "deep"]
  .filter((t) => tiers[t])
  .map((t) => `${tiers[t]} ${t}`)
  .join(", ");
---

<div class="panel" style="margin-top:16px">
  <div class="panel-head">
    <span class="eyebrow">Measured, or stated</span>
    <span class="plus">+</span>
  </div>
  <div class="panel-body">
    <p class="small t-secondary" style="margin:0 0 14px">
      Each row below decides whether a figure on these sheets is a finding or a claim.
    </p>

    <div>
      {rows.map((row) => (
        <div class="gaterow">
          <span class={`state ${row.state}`}>{row.state}</span>
          <div>
            <div class="gtitle">{row.title}</div>
            <div class="gdetail">{row.detail}</div>
          </div>
          <div class="gblocks meta">{row.blocks ?? ""}</div>
        </div>
      ))}
    </div>

    <div style="margin-top:20px">
      <Strip
        items={[
          {
            label: "Covered by a check",
            value: `${covered}/${nodes.length}`,
            context: "Failure modes with a test written against them.",
            tone: covered === nodes.length ? "teal" : "",
          },
          {
            label: "Running, unchecked",
            value: String(wired),
            context: "In the run with no test on their failure modes.",
            tone: wired > 0 ? "amber" : "teal",
          },
          {
            label: "Readers",
            value: String(agents),
            context: tierLine || "No tier recorded.",
          },
          {
            label: "Gates passed",
            value: `${passed}/${rows.length}`,
            context: testRun ? `${testRun.passed} of ${testRun.total} checks pass.` : "Check results not read.",
            tone: passed === rows.length ? "teal" : "amber",
          },
        ]}
      />
    </div>
  </div>
</div>

<style>
  .gaterow {
    display: grid;
    grid-template-columns: 62px 1fr minmax(0, 240px);
    gap: 16px;
    align-items: start;
    padding: 10px 0;
    border-top: 1px solid var(--line);
  }
  .gaterow:first-child { border-top: 0; }
  .gtitle { font-size: 13px; color: var(--white); }
  .gdetail { font-size: 11.5px; color: var(--secondary); line-height: 1.5; margin-top: 2px; }
  .gblocks { text-align: right; }
  @media (max-width: 820px) {
    .gaterow { grid-template-columns: 62px 1fr; }
    .gblocks { grid-column: 2; text-align: left; }
  }
</style>
