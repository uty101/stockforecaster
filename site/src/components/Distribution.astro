---
// Quantile ticks on a single axis, the median taller, the Street marked on the
// same axis. The span indicator underneath carries the interval width.
import * as f from "../lib/fmt.mjs";

const { metric, width = 560 } = Astro.props;
const q = metric.quantiles ?? {};
const points = [q.p10, q.p25, q.p50, q.p75, q.p90].filter((n) => typeof n === "number");
const consensus = typeof metric.consensus === "number" ? metric.consensus : null;

const all = consensus === null ? points : [...points, consensus];
const lo = Math.min(...all);
const hi = Math.max(...all);
const pad = (hi - lo) * 0.14 || Math.abs(hi) * 0.02 || 1;
const min = lo - pad;
const max = hi + pad;
const W = width;
const H = 108;
const axisY = 46;
const x = (v) => ((v - min) / (max - min)) * (W - 60) + 30;
const fv = (v) => f.metricValue(v, metric.units);
---

<svg viewBox={`0 0 ${W} ${H}`} width="100%" height={H} role="img"
  aria-label={`Range for ${metric.metric_label} with the Street marked on the same axis`}>
  <line x1="30" y1={axisY} x2={W - 30} y2={axisY} stroke="#1A2230" stroke-width="1" />

  {[q.p10, q.p25, q.p75, q.p90].filter((n) => typeof n === "number").map((v) => (
    <g>
      <line x1={x(v)} y1={axisY - 7} x2={x(v)} y2={axisY + 7} stroke="#79899C" stroke-width="1" />
      <text x={x(v)} y={axisY - 12} class="tick" text-anchor="middle">{fv(v)}</text>
    </g>
  ))}

  {typeof q.p50 === "number" && (
    <g>
      <line x1={x(q.p50)} y1={axisY - 16} x2={x(q.p50)} y2={axisY + 16} stroke="#35D39A" stroke-width="1.5" />
      <text x={x(q.p50)} y={axisY - 21} class="label" text-anchor="middle" fill="#35D39A">{fv(q.p50)}</text>
    </g>
  )}

  {consensus !== null && (
    <g>
      <line x1={x(consensus)} y1={axisY - 13} x2={x(consensus)} y2={axisY + 13} stroke="#79899C" stroke-width="1" stroke-dasharray="4 4" />
      <text x={x(consensus)} y={axisY + 26} class="label" text-anchor="middle" fill="#79899C">Street {fv(consensus)}</text>
    </g>
  )}

  {typeof q.p10 === "number" && typeof q.p90 === "number" && (
    <g>
      <line x1={x(q.p10)} y1={H - 26} x2={x(q.p90)} y2={H - 26} stroke="#4E5C6E" stroke-width="1" />
      <line x1={x(q.p10)} y1={H - 31} x2={x(q.p10)} y2={H - 21} stroke="#4E5C6E" stroke-width="1" />
      <line x1={x(q.p90)} y1={H - 31} x2={x(q.p90)} y2={H - 21} stroke="#4E5C6E" stroke-width="1" />
      <text x={(x(q.p10) + x(q.p90)) / 2} y={H - 8} class="tick" text-anchor="middle">
        {/* A range needs two figures. Where an end is absent the span still draws,
            and the label states what it is rather than reading as a gap. */}
        {q.p10 !== 0 && q.p90 !== 0 ? `p10 to p90, ${fv(q.p10)} to ${fv(q.p90)}` : "p10 to p90"}
      </text>
    </g>
  )}
</svg>

<style>
  .tick { font-size: 10px; fill: var(--faint); font-family: var(--mono); }
  .label { font-size: 10px; font-family: var(--mono); }
</style>
