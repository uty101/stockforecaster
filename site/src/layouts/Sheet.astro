---
// The frame every sheet sits in: masthead, sheet navigation, meta bar, corner
// marks and the state banners. Built once and used nine times.
import "../styles/tokens.css";
import { anyFixture, incomplete, lockDate, runLabel, header, generatedAt, companies } from "../lib/read.mjs";
import * as f from "../lib/fmt.mjs";

const { title, subsystem, index, project = "ALPHA", version = "v1" } = Astro.props;

// One name is on the book at a time. The box below the title takes a ticker and
// every sheet follows it.
const known = companies.map((c) => ({
  ticker: c.ticker,
  label: f.ticker(c.ticker),
  name: header(c).company,
  period: header(c).period,
}));

const SHEETS = [
  ["01", "System", "/"],
  ["02", "Forecast", "/forecast"],
  ["03", "Reasoning", "/reasoning"],
  ["04", "Model", "/model"],
  ["05", "Risk", "/risk"],
  ["06", "Agents", "/agents"],
  ["07", "Cost", "/cost"],
];

const path = Astro.url.pathname.replace(/\/$/, "") || "/";
const stopped = incomplete
  .map((c) => `${header(c).ticker} stopped at ${header(c).last_completed_stage}`)
  .join(", ");
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title} · {project}</title>
  </head>
  <body>
    <div class="wrap page">
      <span class="corner tl"></span>
      <span class="corner br"></span>

      <header class="masthead">
        <a href="/" class="brandmark">
          <svg width="10" height="10" viewBox="0 0 10 10" aria-hidden="true">
            <path d="M5 0 L10 5 L5 10 L0 5 Z" fill="#35D39A" />
          </svg>
          <span class="name">{project}</span>
        </a>
        <nav class="sheets">
          {SHEETS.map(([, name, href]) => (
            <a href={href} aria-current={href === path ? "page" : undefined}>
              <span>{name}</span>
            </a>
          ))}
        </nav>
      </header>

      <form class="tickerbar" data-ticker-form autocomplete="off">
        <label class="eyebrow" for={`ticker-${index}`}>Name</label>
        <span class="tickerpick">
          <input
            id={`ticker-${index}`}
            class="tickerbox"
            type="text"
            role="combobox"
            aria-expanded="false"
            aria-controls={`names-${index}`}
            aria-describedby={`ticker-state-${index}`}
            autocomplete="off"
            spellcheck="false"
            placeholder="ticker"
            data-ticker
          />
          <button type="button" class="chev" data-ticker-open aria-label="Show the names on the book">
            <svg width="9" height="6" viewBox="0 0 9 6" aria-hidden="true">
              <path d="M0.5 0.5 L4.5 4.5 L8.5 0.5" fill="none" stroke="currentColor" stroke-width="1" />
            </svg>
          </button>
          <ul class="tickerlist" id={`names-${index}`} role="listbox" hidden data-ticker-list>
            {known.map((k) => (
              <li>
                <button type="button" role="option" data-pick={k.ticker}>
                  <span class="t">{k.label}</span>
                  <span class="c">{k.name}</span>
                  <span class="p">{k.period}</span>
                </button>
              </li>
            ))}
          </ul>
        </span>
        <span class="meta" id={`ticker-state-${index}`} data-ticker-state></span>
      </form>


      {anyFixture && (
        <div class="notice">
          <div class="head">
            <svg width="11" height="10" viewBox="0 0 11 10" aria-hidden="true">
              <path d="M5.5 0.5 L10.5 9.5 L0.5 9.5 Z" fill="none" stroke="#A77BFF" stroke-width="1" />
              <path d="M5.5 3.6 L5.5 6.6" stroke="#A77BFF" stroke-width="1" />
              <path d="M5.5 7.6 L5.5 8.2" stroke="#A77BFF" stroke-width="1" />
            </svg>
            <span class="eyebrow">Generated</span>
          </div>
          <div class="line">
            <span class="lead">These figures are generated.</span>{" "}
            <span class="rest">
              The estimates on this sheet came from the fixture writer rather than from a reading of
              the filings, so no figure here carries evidence behind it.
            </span>
          </div>
        </div>
      )}

      {incomplete.length > 0 && (
        <div class="notice">
          <div class="head">
            <svg width="11" height="10" viewBox="0 0 11 10" aria-hidden="true">
              <path d="M5.5 0.5 L10.5 9.5 L0.5 9.5 Z" fill="none" stroke="#A77BFF" stroke-width="1" />
              <path d="M5.5 3.6 L5.5 6.6" stroke="#A77BFF" stroke-width="1" />
              <path d="M5.5 7.6 L5.5 8.2" stroke="#A77BFF" stroke-width="1" />
            </svg>
            <span class="eyebrow">Short run</span>
          </div>
          <div class="line">
            <span class="lead">The work stopped early.</span>{" "}
            <span class="rest">
              {stopped}. What finished is on the page. Nothing has been filled in for what did not.
            </span>
          </div>
        </div>
      )}

      <div class="content" style="margin-top:26px">
        <slot />

        <div class="footbar">
          <div class="pair">
            <div class="eyebrow">Sheet</div>
            <div class="v">{index} {title}</div>
          </div>
          <div class="pair">
            <div class="eyebrow">Run</div>
            <div class="v">{runLabel}</div>
          </div>
          <div class="pair">
            <div class="eyebrow">As of</div>
            <div class="v">{lockDate}</div>
          </div>
          <div class="pair">
            <div class="eyebrow">Built</div>
            <div class="v">{String(generatedAt).slice(0, 16).replace("T", " ")}</div>
          </div>
        </div>
      </div>
    </div>

    <script type="application/json" data-known set:html={JSON.stringify(known)}></script>
    <script>
      // One name at a time. The list sets it, every sheet follows it, and the
      // choice is kept so moving between sheets does not lose the name. The list
      // offers the names that have a run behind them and nothing else, so there
      // is no missing name to report.
      (() => {
        const known = JSON.parse(document.querySelector("[data-known]").textContent);
        const tickers = known.map((k) => k.ticker);
        const KEY = "alpha.name";

        const read = () => {
          try {
            return window.localStorage.getItem(KEY);
          } catch {
            return null;
          }
        };
        const write = (value) => {
          try {
            window.localStorage.setItem(KEY, value);
          } catch {
            /* a page opened from a file keeps the name for the session only */
          }
        };

        // A ticker can be typed with or without its exchange, and a company can
        // be reached by name. Anything else has no run behind it.
        const resolve = (raw) => {
          const text = String(raw ?? "").trim().toUpperCase();
          if (!text) return null;
          const exact = tickers.find((t) => t.toUpperCase() === text);
          if (exact) return exact;
          const bare = tickers.find((t) => t.toUpperCase().split(":").pop() === text);
          if (bare) return bare;
          const named = known.find((k) => (k.name ?? "").toUpperCase().startsWith(text));
          return named ? named.ticker : null;
        };

        // The sealed build carries every sheet in one document, so there is a
        // box per sheet rather than one box. All of them are live and all of
        // them show the same name.
        const boxes = [...document.querySelectorAll("[data-ticker]")];
        const forms = [...document.querySelectorAll("[data-ticker-form]")];
        const states = [...document.querySelectorAll("[data-ticker-state]")];

        const show = (ticker) => {
          const entry = known.find((k) => k.ticker === ticker);
          if (!entry) return;
          for (const section of document.querySelectorAll("[data-company]")) {
            section.hidden = section.dataset.company !== ticker;
          }
          for (const el of document.querySelectorAll("[data-company-name]")) el.textContent = entry.name;
          for (const el of document.querySelectorAll("[data-company-period]")) el.textContent = entry.period;
          for (const box of boxes) box.value = entry.label ?? ticker;
          for (const state of states) state.textContent = "";
          write(ticker);
        };

        const take = (raw) => {
          const match = resolve(raw);
          if (match) {
            show(match);
            return;
          }
          // Nothing is guessed and nothing is hidden. The line states what is
          // missing and what would produce it.
          const wanted = String(raw ?? "").trim().toUpperCase();
          for (const state of states) {
            state.textContent = wanted
              ? `No run for ${wanted}. A run against its filings would produce one.`
              : "";
          }
        };

        const selected = resolve(read()) ?? tickers[0];
        if (selected) show(selected);

        for (const form of forms) {
          form.addEventListener("submit", (event) => {
            event.preventDefault();
            take(form.querySelector("[data-ticker]")?.value);
            close();
          });
        }

        // The list is the same choice as typing, offered to a reader who does
        // not know the tickers by heart.
        const lists = [...document.querySelectorAll("[data-ticker-list]")];
        const close = () => {
          for (const list of lists) list.hidden = true;
          for (const box of boxes) box.setAttribute("aria-expanded", "false");
        };
        const open = () => {
          for (const list of lists) list.hidden = false;
          for (const box of boxes) box.setAttribute("aria-expanded", "true");
        };

        for (const button of document.querySelectorAll("[data-ticker-open]")) {
          button.addEventListener("click", (event) => {
            event.stopPropagation();
            const shut = lists.every((list) => list.hidden);
            if (shut) open();
            else close();
          });
        }

        for (const option of document.querySelectorAll("[data-pick]")) {
          option.addEventListener("click", () => {
            show(option.dataset.pick);
            close();
          });
        }

        for (const box of boxes) {
          box.addEventListener("focus", () => open());
          box.addEventListener("keydown", (event) => {
            if (event.key === "Escape") close();
          });
          // Typing narrows the list to what the letters can still reach.
          box.addEventListener("input", () => {
            const text = box.value.trim().toUpperCase();
            open();
            for (const option of document.querySelectorAll("[data-pick]")) {
              const entry = known.find((k) => k.ticker === option.dataset.pick);
              const reachable =
                !text ||
                (entry.label ?? entry.ticker).toUpperCase().startsWith(text) ||
                entry.ticker.toUpperCase().includes(text) ||
                (entry.name ?? "").toUpperCase().includes(text);
              option.parentElement.hidden = !reachable;
            }
          });
        }

        document.addEventListener("click", (event) => {
          if (!event.target.closest(".tickerpick")) close();
        });
      })();
    </script>
  </body>
</html>

<style>
  .tickerbar {
    display: flex;
    align-items: center;
    gap: 12px;
    flex-wrap: wrap;
    margin-top: 14px;
  }
  .tickerpick { position: relative; display: inline-flex; align-items: center; }
  .tickerbox {
    appearance: none;
    -webkit-appearance: none;
    background: var(--raised);
    border: 1px solid var(--line-strong);
    border-radius: 0;
    color: var(--white);
    font-family: var(--mono);
    font-size: 12px;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    padding: 5px 26px 5px 10px;
    width: 148px;
  }
  .tickerbox::placeholder { color: var(--faint); text-transform: none; letter-spacing: 0.1em; }
  .tickerbox:hover { border-color: var(--secondary); }
  .tickerbox:focus-visible { outline: 1px solid var(--teal); outline-offset: 1px; }

  .tickerpick .chev {
    position: absolute;
    right: 1px;
    top: 1px;
    bottom: 1px;
    width: 22px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    background: none;
    border: 0;
    border-left: 1px solid var(--line);
    color: var(--faint);
    cursor: pointer;
    padding: 0;
  }
  .tickerpick .chev:hover { color: var(--primary); }
  .tickerpick .chev:focus-visible { outline: 1px solid var(--teal); outline-offset: -1px; }

  .tickerlist {
    position: absolute;
    top: calc(100% + 3px);
    left: 0;
    z-index: 20;
    min-width: 268px;
    margin: 0;
    padding: 0;
    list-style: none;
    background: var(--panel);
    border: 1px solid var(--line-strong);
  }
  .tickerlist[hidden] { display: none; }
  .tickerlist li + li { border-top: 1px solid var(--line); }
  .tickerlist button {
    display: flex;
    align-items: baseline;
    gap: 10px;
    width: 100%;
    background: none;
    border: 0;
    padding: 6px 10px;
    font-family: var(--mono);
    font-size: 11px;
    color: var(--body);
    text-align: left;
    cursor: pointer;
  }
  .tickerlist button:hover { background: var(--raised); }
  .tickerlist button:focus-visible { outline: 1px solid var(--teal); outline-offset: -1px; }
  .tickerlist .t { color: var(--white); letter-spacing: 0.1em; min-width: 40px; }
  .tickerlist .c { color: var(--secondary); flex: 1; }
  .tickerlist .p { color: var(--faint); letter-spacing: 0.08em; }
  [data-company][hidden] { display: none; }
</style>
